    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f74eed8-db9d-45b7-acd4-54d70426a781"
      }
    },
    "owner": "kiki200"
  }
