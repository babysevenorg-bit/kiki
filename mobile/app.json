{
  "expo": {
    "name": "Kiki",
    "slug": "kiki",
    "scheme": "kiki",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "com.kiki.wallpaper"
    },
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
